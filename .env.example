LOCAL_LLM_MODEL=qwen2.5:3b-instruct
OLLAMA_MODEL=qwen2.5:3b-instruct
# Copy to .env and fill in. Every field here is read by packages/config/settings.py
# — the single source of configuration (AGENT.md SS7). Never hardcode any of
# these values in code.

ENVIRONMENT=development

# --- LLM provider ---
# "ollama" for local dev ($0, requires `ollama serve` running locally) or
# "hosted" for production (Anthropic API — see Plan.md Executive Architecture
# Decision: Ollama is a dev tool only, never production infrastructure).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:7b-instruct
# Docker Compose uses the internal Ollama service and pulls this model once.
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_KEEP_ALIVE=10m
HOSTED_LLM_API_KEY=
HOSTED_LLM_BASE_URL=https://api.anthropic.com
HOSTED_LLM_MODEL=claude-sonnet-5

# --- Embeddings ---
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# --- Vector store ---
# Local dev: `docker compose -f infrastructure/docker/docker-compose.yml up -d`
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_VOLUME_NAME=docker_qdrant_data

# --- Relational store ---
# Local dev default is a zero-setup sqlite file. Point at Postgres for
# anything beyond a single developer's laptop.
DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# --- Auth ---
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# --- Credential encryption ---
# Generate a real key for anything beyond local dev:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=wZ0nQ3z6r6t2c8m0y6q0k0k3m4h9j1p6y6b3z8t5u4o=

# --- MCP connectors (OAuth apps you register with each provider) ---
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# --- Connector OAuth connect flow (FR-6) ---
# api_base_url must exactly match the redirect URI registered in each
# provider's OAuth app console: {API_BASE_URL}/api/connectors/{provider}/callback
API_BASE_URL=http://localhost:8000
# Where the callback sends the browser back to after connecting.
FRONTEND_BASE_URL=http://localhost:3000
# How often services/ingestion/scheduler.py re-syncs each connected tenant
# (run this on a schedule, e.g. Render Cron — see infrastructure/render.yaml).
INGESTION_RESYNC_INTERVAL_HOURS=6

# --- Rate limiting / CORS ---
RATE_LIMIT_PER_MINUTE=30
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# --- Retrieval defaults ---
RETRIEVAL_TOP_K=6
TOOL_OUTPUT_MAX_CHARS=8000
POSTGRES_VOLUME_NAME=docker_postgres_data
OLLAMA_VOLUME_NAME=docker_ollama_data
